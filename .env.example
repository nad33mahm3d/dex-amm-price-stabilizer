## Required chain + wallet
RPC_URL="https://polygon-rpc.com"
PRIVATE_KEY="0xYOUR_PRIVATE_KEY"
CHAIN_ID=137

## Optional: label for logs (default BASE)
# BASE_TOKEN_SYMBOL="WETH"

## Required target source (strict API-only, no fallback)
INDEX_API_URL="https://example.com/your-price-endpoint.json"
INDEX_API_VALUE_FIELD="value"
PRICE_SCALE_POW=18

## Safety and control (first deployment should remain DRY_RUN=true)
DRY_RUN=true
PRICE_DEVIATION_BPS=1
TARGET_TOLERANCE_BPS=5
SINGLE_TX_MODE=true
SINGLE_TX_MAX_ITERS=36
SLIPPAGE_BPS=120
COOLDOWN_SECONDS=30
POLL_INTERVAL_SECONDS=15
MAX_TRADE_USDC="1000000"
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1500

## Note: MAX_TRADE_USDC is applied to QuickSwap V2 sizing.
## Uniswap V3 uses wallet-available balance bounds instead.

## Enable/disable adapters
ENABLE_UNISWAP_V3=true
## Set true only after QUICKSWAP_V2_BASE_TOKEN_ADDRESS is a real token on your chain.
ENABLE_QUICKSWAP_V2=false

## Base token (non-USDC side of the pool you stabilize)
## QuickSwap V2: required when ENABLE_QUICKSWAP_V2=true.
## Uniswap V3: required unless UNISWAP_V3_POOL_ADDRESS or UNISWAP_V3_POSITION_TOKEN_ID is set (then inferred from pool).
## Example below is WMATIC on Polygon — replace with your stabilized asset.
UNISWAP_V3_BASE_TOKEN_ADDRESS="0x0d500B1d8E8eF31E21C99d1Db9A6444d3ADf1270"
# QUICKSWAP_V2_BASE_TOKEN_ADDRESS="0x0d500B1d8E8eF31E21C99d1Db9A6444d3ADf1270"

## Uniswap V3 overrides (optional)
# UNISWAP_V3_ROUTER_ADDRESS="0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45"
# UNISWAP_V3_FACTORY_ADDRESS="0x1F98431c8aD98523631AE4a59f267346ea31F984"
# UNISWAP_V3_QUOTER_ADDRESS="0x61fFE014bA17989E743c5F6cB21bF9697530B21e"
# UNISWAP_V3_POSITION_MANAGER_ADDRESS="0xC36442b4a4522E871399CD717aBDD847Ab11FE88"
# UNISWAP_V3_USDC_PRIMARY_ADDRESS="0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359"
# UNISWAP_V3_USDC_SECONDARY_ADDRESS="0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174"
# UNISWAP_V3_POOL_ADDRESS="0x..."
# UNISWAP_V3_POOL_FEE=3000
# UNISWAP_V3_POSITION_TOKEN_ID=864478

## QuickSwap V2 overrides (optional)
# QUICKSWAP_V2_ROUTER_ADDRESS="0xa5E0829CaCEd8fFDD4De3c43696c57F7D7A678ff"
# QUICKSWAP_V2_FACTORY_ADDRESS="0x5757371414417b8C6CAad45bAeF941aBc7d3Ab32"
# QUICKSWAP_V2_USDC_PRIMARY_ADDRESS="0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359"
# QUICKSWAP_V2_USDC_SECONDARY_ADDRESS="0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174"
